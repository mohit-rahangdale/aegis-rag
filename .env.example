# ==============================================================================
# AegisRAG Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to source control!
# ==============================================================================

# Application Settings
APP_NAME=aegisrag
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# Primary & Fallback LLM Providers (Phase 2)
GEMINI_API_KEY=
MISTRAL_API_KEY=
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=mistral

# Storage & Databases (Phase 3)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegisrag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=
QDRANT_API_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aegisrag-documents
MINIO_SECURE=false

# Observability (Phase 12)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
